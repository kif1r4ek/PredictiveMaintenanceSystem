# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Models ────────────────────────────────────────────────────────────────────
BINARY_MODEL_PATH=models/binary_model.pkl
MULTICLASS_MODEL_PATH=models/multiclass_model.pkl

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=pm_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=predictive_maintenance
DATABASE_URL=postgresql+asyncpg://pm_user:changeme@postgres:5432/predictive_maintenance

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_HISTORY_KEY=pm:recent_inputs
REDIS_HISTORY_LIMIT=100       # сколько последних вводов хранить

# ── Logging ───────────────────────────────────────────────────────────────────
# Уровни: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# DEBUG    — всё подряд: входящие данные, шаги inference, SQL-запросы, Redis ops
# INFO     — штатные события: запрос принят, предсказание выполнено, модель загружена
# WARNING  — нештатно, но не критично: медленный inference, порог близко к границе
# ERROR    — ошибка обработки запроса, сбой записи в БД
# CRITICAL — сервис неработоспособен: модель не загрузилась, нет связи с PostgreSQL

# ── Monitoring ────────────────────────────────────────────────────────────────
LOKI_URL=http://loki:3100/loki/api/v1/push
PROMETHEUS_ENABLED=true

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
